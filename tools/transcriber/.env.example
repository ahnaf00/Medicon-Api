# The agent runs on the same PC as LiveKit, so it connects locally.
LIVEKIT_URL=ws://127.0.0.1:7880
# Must match Medicon-api/.env (LIVEKIT_API_KEY / LIVEKIT_API_SECRET) and the
# --keys "devkey: <secret>" the LiveKit server was started with.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Laravel API (php artisan serve). Chunks go to {API_BASE_URL}/internal/transcriber/...
API_BASE_URL=http://127.0.0.1:8000/api/v1
# Must match TRANSCRIBER_SECRET in Medicon-api/.env (32+ characters).
TRANSCRIBER_SECRET=

# Optional: where chunks are written before upload (default: ./storage).
# TRANSCRIBER_STORAGE_DIR=
